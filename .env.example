# Copy to `.env` (gitignored) and edit. Read by eda/paths.py; an exported
# shell variable of the same name always wins over what is written here.

# The drive holding parquet/ and derived/. Unset, everything resolves under the
# repo root, which is where the 2020 data sat originally.
KOREAN_DATA_ROOT=/Volumes/YOUR_DRIVE/Korean

# Optional, only if the three trees are not together under KOREAN_DATA_ROOT.
# For the 2026 expansion the useful split is source parquet on the external
# drive, derived files written back to the internal disk.
#KOREAN_PARQUET_DIR=/Volumes/YOUR_DRIVE/Korean/parquet
#KOREAN_DERIVED_DIR=/Users/waynliu/Documents/Research/Explore/Korean/derived
#KOREAN_RAW_DIR=/Volumes/YOUR_DRIVE/Korean/raw
